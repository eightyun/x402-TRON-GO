# 仅测试网示例；本文件不自动加载。请分别向服务注入所需变量，不要提交真实.env。
X402_NETWORK=tron:3448148188
X402_ASSET=
X402_PAY_TO=
X402_MAX_AMOUNT_ATOMIC=1000
X402_PRICE_ATOMIC=1000

# 必须独立核验部署地址和完整runtime代码哈希；不从节点自动学习。
X402_PERMIT2_ADDRESS=
X402_PROXY_ADDRESS=
X402_PERMIT2_CODE_HASH=
X402_PROXY_CODE_HASH=
X402_JSON_RPC_URL=
X402_NATIVE_NODE_URL=
X402_GENESIS_BLOCK_ID=
X402_NODE_API_KEY=
# 显式开启需节点支持JSON-RPC batch；失败不自动降级，默认保留单请求。
X402_RPC_BATCH=false

# 使用已显式应用schema的专用PostgreSQL库，运行角色不要DDL/DELETE/TRUNCATE权限。
X402_DATABASE_URL=
X402_EXECUTOR_KEY_FILE=
X402_FEE_LIMIT_SUN=20000000
X402_SETTLEMENT_TIMEOUT=90s
X402_MAX_CONCURRENT=1
X402_FACILITATOR_LISTEN_ADDR=127.0.0.1:8081
X402_FACILITATOR_URL=http://127.0.0.1:8081
X402_FACILITATOR_TOKEN=
X402_ALLOW_INSECURE_LOCAL_FACILITATOR_HTTP=true
X402_LISTEN_ADDR=127.0.0.1:8080

# 明文仅用于本机；对外必须HTTPS。pay/recover都需要显式启用。
X402_RESOURCE_URL=http://127.0.0.1:8080/resource
X402_ALLOW_INSECURE_LOCAL_RESOURCE_HTTP=true
X402_ENABLE_TESTNET_PAYMENTS=false
X402_PAYER_ADDRESS=
X402_PAYER_KEY_FILE=
# 预先建立当前服务用户独占的0700目录；一个目录只对应一个付款意图。
X402_PAYMENT_STATE_DIR=
